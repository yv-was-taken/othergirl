SERVER_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/othergirl
REDIS_URL=redis://127.0.0.1:6379
# How many right-most X-Forwarded-For hops to trust for source IP.
# 0 = ignore X-Forwarded-For and use the direct peer IP (recommended default).
# 1 = trust the last forwarded IP, 2 = second-to-last, etc.
TRUSTED_PROXY_HOPS=0
# Required: set to a strong random secret (at least 32 characters)
# Example: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=60
# Must be a specific origin (wildcard '*' is rejected). Comma-separated for multiple.
CORS_ORIGIN=http://localhost:5173

PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_WEB_BASE_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/settings
STRIPE_CANCEL_URL=http://localhost:3000/settings
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/settings
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/settings

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
OAUTH_STATE_TTL_SECONDS=600

MATCHER_INTERVAL_MS=500
QUEUE_SESSION_TTL_SECONDS=3600
MATCH_COOLDOWN_SECONDS=5
# Required: independent 32-byte base64 key for chat message encryption.
# Generate with: openssl rand -base64 32
CHAT_KEY_ENCRYPTION_KEY_B64=
# Optional migration key(s), comma-separated base64 32-byte values
CHAT_KEY_ENCRYPTION_KEY_LEGACY_B64=

EMOTE_UPLOAD_DIR=uploads/emotes
EMOTE_PUBLIC_BASE_URL=http://localhost:8080/assets/emotes

# comma-separated user UUIDs allowed to upload emotes
ADMIN_USER_IDS=
