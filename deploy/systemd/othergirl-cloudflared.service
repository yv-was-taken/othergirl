[Unit]
Description=Othergirl Cloudflare Tunnel
After=network-online.target othergirl-backend.service
Wants=network-online.target

[Service]
Type=simple
# Token is loaded via LoadCredential and exported as TUNNEL_TOKEN so that
# cloudflared reads it from its environment instead of the command line.
# This prevents the secret from being visible in ps aux / /proc/<pid>/cmdline.
LoadCredential=tunnel-token:/etc/othergirl/tunnel-token
ExecStart=/bin/sh -c 'export TUNNEL_TOKEN="$(cat %d/tunnel-token)" && exec cloudflared tunnel --no-autoupdate run'
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
